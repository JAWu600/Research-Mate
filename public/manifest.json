{
    "manifest_version": 3,
    "name": "Paper Reading Assistant",
    "version": "1.1.0",
    "description": "提取文献网页内容，辅助论文阅读",
    "permissions": ["activeTab", "sidePanel", "scripting"],
    "host_permissions": [
      "<all_urls>" 
    ],
    "action": {
      "default_title": "打开文献阅读助手"
    },
    "side_panel": {
      "default_path": "src/sidebar/index.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }
  
  